# Configuración del entorno del servidor
PORT=3000
NODE_ENV=development

# Configuración de base de datos con Sequelize ORM
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configuración de Seguridad y Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=24h

# Parámetros para PostgreSQL o MySQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gestion_docentes
# DB_USER=postgres
# DB_PASS=postgres
